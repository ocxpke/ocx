# ESP32-S3-DevKitC-1-N16R8: 16 MB de flash (QIO) y 8 MB de PSRAM octal.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Retardos de 1 ms exactos en la HAL.
CONFIG_FREERTOS_HZ=1000
# Consola por el USB-Serial/JTAG del DevKitC (conector "USB").
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# bt817_wr_mem usa ~0,5 kB de pila; margen para printf/snprintf.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
